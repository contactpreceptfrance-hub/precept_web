# Neon Postgres — pooled URL (hostname contains "-pooler") for the app…
DATABASE_URL=
# …and the direct URL (same host without "-pooler") for Prisma Migrate.
DATABASE_URL_UNPOOLED=
# Public origin, used for Stripe redirect URLs and metadataBase.
NEXT_PUBLIC_BASE_URL=https://www.preceptfrance.fr
# Stripe keys — https://dashboard.stripe.com/apikeys ; webhook secret from Developers > Webhooks
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Rate limiting (phase 0) ---
# Salt for the non-reversible IP fingerprint stored in RateLimitHit.
# Generate with: openssl rand -hex 16
# If unset, rate limiting is disabled and a warning is logged.
RATE_LIMIT_SALT=
