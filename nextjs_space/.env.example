# Neon Postgres — pooled URL (hostname contains "-pooler") for the app…
DATABASE_URL=
# …and the direct URL (same host without "-pooler") for Prisma Migrate.
DATABASE_URL_UNPOOLED=
# Public origin, used for Stripe redirect URLs and metadataBase.
NEXT_PUBLIC_BASE_URL=https://www.preceptfrance.fr
# Stripe keys — https://dashboard.stripe.com/apikeys ; webhook secret from Developers > Webhooks
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Rate limiting (phase 0) ---
# Salt for the non-reversible IP fingerprint stored in RateLimitHit.
# Generate with: openssl rand -hex 16
# If unset, rate limiting is disabled and a warning is logged.
RATE_LIMIT_SALT=

# --- Admin area (phase 1) ---
# The single shared password the team types at /admin/login. 20+ characters.
ADMIN_PASSWORD=
# Signs the admin session cookie. Unrelated to ADMIN_PASSWORD.
# Generate with: openssl rand -base64 32
# Changing this value logs everyone out — that is the revocation mechanism.
ADMIN_SESSION_SECRET=

# --- Book cover uploads (/admin/livres) ---
# Vercel Blob read-write token. Create a Blob store in the Vercel project
# (Storage > Create > Blob) and Vercel adds this variable for you; copy it here
# only to test uploads locally. Without it, the book manager still works but
# refuses any image upload.
BLOB_READ_WRITE_TOKEN=

# --- Transactional email (phase 4) ---
# Brevo API key (Settings > SMTP & API > API Keys) and the sender identity —
# contact@preceptfrance.fr must be a verified sender in Brevo (DKIM/DMARC).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=contact@preceptfrance.fr
BREVO_SENDER_NAME=Precept France
# Where contact-form / study-group submissions are notified. Received by
# Migadu, so this can safely be the same address as BREVO_SENDER_EMAIL.
TEAM_NOTIFICATION_EMAIL=contact@preceptfrance.fr
# Optional extra recipient (kept on the old Gmail inbox during the Migadu
# transition). Leave unset to notify only TEAM_NOTIFICATION_EMAIL.
TEAM_NOTIFICATION_EMAIL_CC=
