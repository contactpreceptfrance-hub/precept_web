generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon: app traffic goes through the pooler; Prisma Migrate needs the direct host.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Product {
  id           String      @id @default(cuid())
  name         String
  description  String
  price        Float
  imageUrl     String
  // Back cover. Nullable: not every product has one, and for the Précepte sur
  // Précepte and Saisir et Agir titles this is a generic series back shared
  // across all of them rather than artwork specific to the title.
  backImageUrl String?
  // Sample lesson or companion PDF (e.g. /pdfs/... or Vercel Blob URL).
  samplePdfUrl String?
  type         ProductType
  series       String? // "40min" | "seigneur" | "etudes" | "saisir" | "pup" | "enfants"
  // Hidden from the shop, sitemap and checkout when false. Used instead of
  // deleting: OrderItem keeps a RESTRICT foreign key to the product.
  published    Boolean     @default(true)
  // Still visible, but cannot be added to a cart or bought.
  soldOut      Boolean     @default(false)
  // Copies in hand. null = not tracked (always available unless soldOut is
  // set). When set, it is checked at checkout and decremented by the webhook
  // once an order is paid; at 0 the book counts as sold out.
  stock        Int?
  // Position within its series, ascending. createdAt breaks ties.
  sortOrder    Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  orderItems   OrderItem[]
  ateliers     Atelier[]
}

enum ProductType {
  LIVRE
  FORMATION
}

model Order {
  id              String      @id @default(cuid())
  stripeSessionId String      @unique
  customerEmail   String
  customerName    String
  // Formatted address block collected by Stripe Checkout. Nullable: orders
  // placed before shipping collection was switched on have none, and the admin
  // list flags those as unfulfillable rather than hiding them.
  shippingAddress String?
  status          OrderStatus @default(PENDING)
  totalAmount     Float
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  items           OrderItem[]

  // The admin list reads orders newest-first, either unfiltered or narrowed to
  // one status. A composite on (status, createdAt) cannot serve the unfiltered
  // ordering, so both indexes are needed.
  @@index([createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id])
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  // Name at the time of sale. unitPrice already snapshots the price, but the
  // name did not: renaming a book used to rewrite every past order that
  // contained it. Nullable only for rows predating this column.
  productName String?
  quantity    Int
  unitPrice   Float

  // Postgres does not index foreign keys on its own, so `include: { items }`
  // was sequentially scanning the whole table on every admin page load.
  @@index([orderId])
  @@index([productId])
}

// A gift received through Stripe Checkout. Rows exist only once the money is
// in: a monthly gift produces one row per paid invoice. Kept apart from Order
// because an Order needs line items that point at a Product.
model Donation {
  id                   String   @id @default(cuid())
  // Null for renewals: they come from invoice.paid, not from a Checkout session.
  stripeSessionId      String?  @unique
  stripeSubscriptionId String?
  // Set for monthly gifts. Shared by the first checkout and its invoice.paid
  // event, so whichever arrives second finds the row instead of duplicating it.
  stripeInvoiceId      String?  @unique
  amount               Float
  recurring            Boolean  @default(false)
  donorEmail           String?
  donorName            String?
  createdAt            DateTime @default(now())

  @@index([createdAt])
  @@index([recurring, createdAt])
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
}

model ContactSubmission {
  id        String    @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  createdAt DateTime  @default(now())
  /// Unused. Free-form string from the original scaffold, never read or
  /// written by any code. `handledAt` replaces it; left in place rather than
  /// dropped so this migration stays non-destructive.
  status    String    @default("nouveau")
  // When the team dealt with the message. A nullable timestamp answers both
  // "is it handled" and "when", sorts, and needs no backfill: every existing
  // row is correctly unhandled.
  handledAt DateTime?
  // Which form produced this: the contact section or the study-group request.
  // Always written server-side from a fixed allowlist, never from client text.
  source    String    @default("contact")

  @@index([createdAt])
  @@index([handledAt, createdAt])
  @@index([source, createdAt])
}

/// One recorded request against a rate-limited endpoint.
///
/// Postgres rather than an in-memory Map: on Vercel each lambda instance would
/// keep its own counter, so the effective limit multiplied by the number of
/// warm instances and reset on every cold start. This is shared state, which is
/// the only thing that actually limits anything.
model RateLimitHit {
  id        String   @id @default(cuid())
  bucket    String // "contact" | "checkout" | "don" | "admin_login"
  // sha256(ip + RATE_LIMIT_SALT). The raw address is never stored, which keeps
  // this out of the "personal data" bucket the privacy policy has to describe.
  ipHash    String
  createdAt DateTime @default(now())

  @@index([bucket, ipHash, createdAt])
  @@index([createdAt])
}

/// Dynamic application configuration (e.g. Stripe settings).
/// Secrets are encrypted at rest using AES-256-GCM.
model AppSetting {
  key       String   @id
  value     String
  isSecret  Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

/// Weekly or recurring virtual Zoom study workshop (Atelier).
model Atelier {
  id             String    @id @default(cuid())
  title          String
  description    String
  // Human-readable recurring schedule, e.g. "Tous les mardis de 20h00 à 21h30 (Heure de Paris)"
  scheduleText   String
  // Optional date/time of the next upcoming session (powers calendar export & spotlight)
  nextDate       DateTime?
  durationMin    Int       @default(90)
  leaderName     String?
  zoomUrl        String
  // Optional Meeting ID / Passcode or short connection note
  zoomInfo       String?

  // Optional link to a Book in the shop (Acheter le livre is optional for participants)
  productId      String?
  product        Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  // Optional custom cover or PDF override (if no book is linked or a custom handout is used)
  customImageUrl String?
  customPdfUrl   String?

  featured       Boolean   @default(false)
  published      Boolean   @default(true)
  sortOrder      Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([published, sortOrder])
  @@index([productId])
}


